{
  "name": "wildroot-web3-resolution",
  "version": "0.6.0",
  "description": "Wildroot’s web3 name resolution: which namespace an address belongs to, and how each is resolved and verified — Handshake (SPV chain proof, DNSSEC anchored to the on-chain DS, DANE), ICANN over encrypted and oblivious DNS, IPFS/IPNS, Arweave, ENS and web3://, Nostr, DID/AT Protocol/ActivityPub, Tor, and the key-addressed networks. The reference implementation behind the Wildroot browser, with its written standard.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Matt <bpmatt@gmail.com>",
  "main": "src/resolver.js",
  "exports": {
    ".": "./src/resolver.js",
    "./resolver": "./src/resolver.js",
    "./doh": "./src/doh.js",
    "./dnssec": "./src/dnssec.js",
    "./dns-query": "./src/dns-query.js",
    "./denial": "./src/denial.js",
    "./dane": "./src/dane.js",
    "./trust-path": "./src/trust-path.js",
    "./hip5-op": "./src/hip5-op.js",
    "./hns-url": "./src/hns-url.cjs",
    "./hns-host": "./src/hns-host.js",
    "./odoh": "./src/odoh.js",
    "./spv": "./src/spv.js",
    "./pointers": "./src/pointers.js",
    "./safe-address": "./src/safe-address.js",
    "./reserved-names": "./src/reserved-names.cjs",
    "./safe-status": "./src/safe-status.js",
    "./search-url": "./src/search-url.js",
    "./contenthash": "./src/contenthash.js",
    "./dns-policy": "./namespaces/icann/src/dns-policy.js",
    "./ar": "./namespaces/arweave/src/ar.js",
    "./ens-protocol": "./namespaces/ens/src/ens-protocol.js",
    "./ccip-read": "./namespaces/ens/src/ccip-read.js",
    "./web3-protocol": "./namespaces/ens/src/web3-protocol.js",
    "./nostr-protocol": "./namespaces/nostr/src/nostr-protocol.js",
    "./nostr/relay": "./namespaces/nostr/src/relay.js",
    "./nostr/nip19": "./namespaces/nostr/src/nip19.js",
    "./nostr/event": "./namespaces/nostr/src/event.js",
    "./did-protocol": "./namespaces/did/src/did-protocol.js",
    "./onion-protocol": "./namespaces/tor/src/onion-protocol.js",
    "./anonymize": "./namespaces/tor/src/anonymize.js",
    "./magnet-protocol": "./namespaces/keys/src/magnet-protocol.js",
    "./gemini-protocol": "./namespaces/keys/src/gemini-protocol.js",
    "./origin-warm": "./namespaces/ipfs/src/origin-warm.js",
    "./cid": "./namespaces/ipfs/src/cid.js",
    "./socks-dial": "./src/socks-dial.js",
    "./classify-host": "./src/classify-host.cjs"
  },
  "files": [
    "src",
    "namespaces/*/src",
    "namespaces/*/SPEC.md",
    "SPEC.md",
    "REFERENCES.md",
    "DEVIATIONS.md",
    "DIVERGENCE.md",
    "LICENSE",
    "LICENSE-SPEC",
    "scripts/parity.mjs"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "lint": "standard",
    "parity": "node scripts/parity.mjs",
    "sync": "node scripts/parity.mjs --sync",
    "docs": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check"
  },
  "dependencies": {
    "@derhuerst/gemini": "^1.3.2",
    "ws": "^8.18.2",
    "@noble/curves": "^1.9.2",
    "@noble/hashes": "2.3.0",
    "multiformats": "^9.9.0",
    "viem": "2.32.1",
    "web3protocol": "^0.6.2"
  },
  "optionalDependencies": {
    "hsd": "^8.0.0"
  },
  "devDependencies": {
    "standard": "^17.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "standard": {
    "ignore": [
      "tests/fixtures/"
    ]
  },
  "keywords": [
    "handshake",
    "hns",
    "dnssec",
    "dane",
    "doh",
    "odoh",
    "hip-5",
    "name-resolution",
    "spv",
    "ens",
    "ipfs",
    "ipns",
    "arweave",
    "nostr",
    "did",
    "atproto",
    "tor",
    "onion",
    "gemini",
    "hypercore",
    "bittorrent",
    "web3"
  ]
}
